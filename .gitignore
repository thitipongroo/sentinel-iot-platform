# Environment — never commit real secrets
.env

# MQTT TLS certificates and private keys (generated by scripts/gen-mqtt-certs.sh)
mosquitto/certs/*.crt
mosquitto/certs/*.key
mosquitto/certs/*.pem
mosquitto/certs/*.srl

# Mosquitto runtime password file (generated by docker-entrypoint.sh at container start)
mosquitto/config/passwd

# k6 load test results
load-testing/results.json

# macOS
.DS_Store

# Build outputs
backend/target/
frontend/.next/
frontend/node_modules/
simulator/node_modules/
