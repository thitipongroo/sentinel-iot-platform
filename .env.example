# ──────────────────────────────────────────────────────────────────────────────
# Sentinel IoT Platform — Environment Variables
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit the actual .env file.
# ──────────────────────────────────────────────────────────────────────────────

# Required — generate with: openssl rand -base64 48
JWT_SECRET=

# Required — initial admin/operator passwords seeded on first run.
# These are only used when the users don't exist yet (safe to re-run).
# Generate with: openssl rand -base64 24
# NEVER commit real values. Leave blank to skip auto-seeding (create users manually).
INIT_ADMIN_PASSWORD=
INIT_OPERATOR_PASSWORD=

# MQTT broker credentials — change all defaults before any internet-facing deployment.
# MQTT_USER / MQTT_PASS     : backend service account (subscribe telemetry, publish DLQ)
# MQTT_DEVICE_USER / _PASS  : shared device account (publish telemetry only)
# Default "changeme" values work for local dev but MUST be rotated in production.
MQTT_USER=sentinel-backend
MQTT_PASS=changeme
MQTT_DEVICE_USER=sentinel-device
MQTT_DEVICE_PASS=changeme

# CORS — set to your production frontend URL (comma-separated for multiple origins)
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Notification providers — enable exactly one for production alerting.
# LINE Notify (deprecated — migrate to LINE Messaging API before shutdown)
LINE_NOTIFY_TOKEN=
LINE_NOTIFY_ENABLED=false
# Slack incoming webhook
SLACK_WEBHOOK_URL=
SLACK_NOTIFY_ENABLED=false
# Generic outbound webhook (any HTTP endpoint that accepts JSON POST)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_ENABLED=false
NOTIFY_WEBHOOK_SECRET=

# Optional — alert thresholds (defaults shown)
TEMP_THRESHOLD=80
SMOKE_THRESHOLD=200
HUMIDITY_THRESHOLD=90

# Optional — simulator config
SIMULATOR_INTERVAL=5000
SIMULATOR_DEVICES=sensor-1,sensor-2,sensor-3

# Optional — Grafana admin password
GRAFANA_PASSWORD=changeme

# Optional — audit log retention (days, default 90)
AUDIT_RETENTION_DAYS=90
